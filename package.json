{
  "name": "schedule-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "对话式日程渲染工具：作业、课表、比赛一句话进日历",
  "scripts": {
    "test": "node --import tsx --test tests/regressions.test.ts",
    "test:ui": "npm run build && node --import tsx --test tests/ui.test.ts",
    "test:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-android.ps1",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:mobile": "vite build --mode mobile",
    "test:mobile": "npm run build:mobile && node --import tsx --test tests/mobile.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ical.js": "^2.2.1",
    "liquid-glass-react": "^1.1.1",
    "node-ical": "^0.27.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
